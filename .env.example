# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real credentials.

# Stripe — use TEST keys for local dev, never live keys in source.
# Get from https://dashboard.stripe.com/test/apikeys
STRIPE_PK=pk_test_REPLACE_ME
STRIPE_SK=sk_test_REPLACE_ME        # Lambda env var only, never in Flutter
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME  # Lambda env var only

# API base URL — defaults to /prod if not set
API_BASE_URL=https://pq8cu94cfd.execute-api.us-east-1.amazonaws.com/prod

# Agora — App ID is low-sensitivity (public by design), Certificate is server-only
AGORA_APP_ID=REPLACE_ME             # passes to --dart-define

# Gemini — get a new key from aistudio.google.com (the old hardcoded key was revoked)
# Also set GEMINI_API_KEY in the ai-chat Lambda env var.
GEMINI_API_KEY=REPLACE_ME           # passes to --dart-define; also needed in Lambda

# AGORA_APP_CERTIFICATE goes in Lambda env var only, never here
